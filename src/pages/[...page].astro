---
import type { GetStaticPaths } from "astro";
import Pagination from "../components/control/Pagination.astro";
import FanMap from "../components/FanMap.astro";
import FanWelcome from "../components/FanWelcome.astro";
import FanGroups from "../components/FanGroups.astro";
import HomeArchiveDetails from "../components/HomeArchiveDetails.astro";
import HomepageNow from "../components/HomepageNow.astro";
import PostPage from "../components/PostPage.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { getHomepageContent } from "../utils/homepage-content";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const len = page.data.length;
const isFirstPage = page.currentPage === 1;
const home = isFirstPage ? await getHomepageContent() : undefined;
---

<MainGridLayout layout={isFirstPage ? "home" : "home-list"}>
    {home && <>
        <FanWelcome memories={home.memories} />
        <HomepageNow now={home.now} />
        <FanGroups />
    </>}
    {isFirstPage && <FanMap />}
    {len > 0 && <>
        <PostPage page={page}></PostPage>
        <Pagination class="home-pagination mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
    </>}
    <HomeArchiveDetails />
</MainGridLayout>

<style>
    :global(.home-pagination) { margin-block: 20px 22px; }
</style>
