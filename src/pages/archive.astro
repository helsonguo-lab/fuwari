---
import ArchivePanel from "@components/ArchivePanel.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "../utils/content-utils";

const sortedPostsList = (await getSortedPostsList()).filter(
	post => ["线下", "生日"].includes(post.data.category || ""),
);
---

<MainGridLayout title="追星手记">
    <section class="card-base p-7 md:p-9 mb-4" data-pagefind-body>
        <h1 class="text-3xl font-bold text-90">追星手记</h1>
    </section>
    <ArchivePanel sortedPosts={sortedPostsList} categoryTabs={["线下", "生日"]} client:only="svelte"></ArchivePanel>
</MainGridLayout>

