---
import { photos } from "../data/photos";
import { url } from "../utils/url-utils";
---
<section class="card-base p-7 md:p-9 mb-4 relative overflow-hidden">
  <p class="text-xs tracking-[.2em] text-[var(--primary)] font-bold mb-3">JUNNIE’S JOURNAL ✦</p>
  <h1 class="text-3xl md:text-4xl font-bold text-90 leading-snug">欢迎来到Junnie的个人主页</h1>
  <p class="text-60 leading-7 mt-4 max-w-xl">这里记录追星和科研日常</p>
  <div class="flex flex-wrap gap-3 mt-6">
    <a href={url('/gallery/')} class="apple-btn apple-btn-glass">看看我的线下返图</a>
    <a href={url('/research/')} class="apple-btn apple-btn-glass">打开科研手记</a>
  </div>
</section>
<section class="grid sm:grid-cols-2 gap-4 mb-4" aria-label="我的喜欢">
  {[{ name: 'IVE', fandom: 'DIVE', note: '喜欢小圆的第7年', tone: 'ive' }, { name: 'NMIXX', fandom: 'NSWER', note: '220222接生的小啾', tone: 'nmixx' }].map(group => (
    <a href={url('/gallery/') + '?group=' + group.name} class:list={['group-card card-base p-7', group.tone]}>
      <p class="text-xs tracking-[.2em] opacity-70">{group.fandom} ♡</p>
      <h2 class="text-3xl font-bold mt-2 tracking-wide">{group.name} <span class="text-lg float-right" aria-hidden="true">↗</span></h2>
      <p class="text-sm mt-3 opacity-80">{group.note}</p>
      <p class="text-xs mt-5 opacity-60">{photos.some(photo => photo.group === group.name) ? photos.filter(photo => photo.group === group.name).length + ' 张现场记忆' : '现场照片 · 整理中'}</p>
    </a>
  ))}
</section>
<style>
  /* Apple-style pill buttons: SF-like type, 980px radius and a glass secondary. */
  .apple-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border-radius: 980px;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Helvetica Neue", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
    font-size: .9375rem;
    font-weight: 500;
    letter-spacing: -.01em;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: background-color .2s ease, box-shadow .2s ease, color .2s ease, transform .2s cubic-bezier(.25, .1, .25, 1);
  }
  .apple-btn:active { transform: scale(.97); }
  .apple-btn:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
  .apple-btn-glass {
    color: var(--btn-content);
    background-color: rgb(255 255 255 / 55%);
    border: 1px solid rgb(255 255 255 / 65%);
    box-shadow: 0 1px 2px rgb(54 82 101 / 8%), inset 0 1px 0 rgb(255 255 255 / 55%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
  }
  .apple-btn-glass:hover { background-color: rgb(255 255 255 / 75%); }
  .apple-btn-glass:active { background-color: rgb(245 250 255 / 85%); }
  :global(.dark) .apple-btn-glass {
    color: #eaf3fa;
    background-color: rgb(38 58 74 / 55%);
    border-color: rgb(214 232 244 / 18%);
    box-shadow: 0 1px 2px rgb(0 0 0 / 25%), inset 0 1px 0 rgb(214 232 244 / 12%);
  }
  :global(.dark) .apple-btn-glass:hover { background-color: rgb(48 72 91 / 65%); }
  :global(.dark) .apple-btn-glass:active { background-color: rgb(58 84 105 / 75%); }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .apple-btn-glass { background-color: var(--card-bg); }
  }
  @media (prefers-reduced-transparency: reduce) {
    .apple-btn-glass {
      background-color: var(--card-bg);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .apple-btn { transition: none; }
    .apple-btn:active { transform: none; }
  }

  .group-card { transition: transform .2s, box-shadow .2s; }
  .group-card:hover { transform: translateY(-3px); box-shadow: 0 10px 30px #4868791a; }
  .ive { background: linear-gradient(120deg, #f7bfd7bf, #fff0f6bf); color: #83445e; }
  .nmixx { background: linear-gradient(120deg, #f7fbff99, #b5c7d380); color: #405f73; }
  :global(.dark) .ive { background: linear-gradient(120deg, #73435999, #382631b3); color: #f6d7e5; }
  :global(.dark) .nmixx { background: linear-gradient(120deg, #1d2e3bb3, #344e6380); color: #d4e4ee; }
</style>
