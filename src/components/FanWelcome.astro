---
import { Icon } from "astro-icon/components";
import MemoryStack from "./MemoryStack.astro";
import type { MemoryContent } from "../utils/homepage-content";
import { url } from "../utils/url-utils";
interface Props { memories?: MemoryContent[]; }
const { memories = [] } = Astro.props;
---
<section class="card-base p-7 md:p-9 mb-4 relative overflow-hidden">
  <p class="text-xs tracking-[.2em] text-[var(--primary)] font-bold mb-3">JUNNIE’S JOURNAL ✦</p>
  <h1 class="text-3xl md:text-4xl font-bold text-90 leading-snug">欢迎来到Junnie的个人主页</h1>
  <p class="text-60 leading-7 mt-4 max-w-xl">这里记录追星和科研日常</p>
  <div class="apple-link-row">
    <a href={url('/gallery/')} class="apple-link">看看我的线下返图
      <Icon name="material-symbols:chevron-right-rounded" class="apple-chevron" aria-hidden="true"></Icon>
    </a>
    <MemoryStack memories={memories} />
    <a href={url('/research/')} class="apple-link">打开科研手记
      <Icon name="material-symbols:chevron-right-rounded" class="apple-chevron" aria-hidden="true"></Icon>
    </a>
  </div>
</section>
<style>
  /* Apple-style inline links: quiet 15px accent text with a small chevron,
     like the "Learn more" links on apple.com. Kept at a 44px tap height. */
  .apple-link-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.75rem;
    margin-top: 1.25rem;
  }
  .apple-link-row :global(.apple-link) {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    min-height: 44px;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Helvetica Neue", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
    font-size: .9375rem;
    font-weight: 500;
    letter-spacing: -.01em;
    line-height: 1;
    white-space: nowrap;
    color: var(--primary);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: color .2s ease, opacity .2s ease;
  }
  .apple-link-row :global(.apple-chevron) {
    font-size: 1.125rem;
    transition: transform .2s cubic-bezier(.25, .1, .25, 1);
  }
  .apple-link-row :global(.apple-link:hover) { color: var(--title-active); }
  .apple-link-row :global(.apple-link:hover .apple-chevron) { transform: translateX(2px); }
  .apple-link-row :global(.apple-link:active) { opacity: .55; }
  .apple-link-row :global(.apple-link:focus-visible) {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
    border-radius: .375rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .apple-link-row :global(.apple-link) { transition: none; }
    .apple-link-row :global(.apple-chevron) { transition: none; }
    .apple-link-row :global(.apple-link:hover .apple-chevron) { transform: none; }
  }

</style>
