---
import { Icon } from "astro-icon/components";
import MemoryStack from "./MemoryStack.astro";
import Profile from "./widget/Profile.astro";
import ProfileLinks from "./widget/ProfileLinks.astro";
import type { MemoryContent } from "../utils/homepage-content";
import { url } from "../utils/url-utils";
interface Props { memories?: MemoryContent[]; }
const { memories = [] } = Astro.props;
---
<section class="home-hero" aria-labelledby="home-title" data-home-hero>
  <Profile compact showLinks={false} />
  <div class="hero-copy">
    <p class="hero-kicker" aria-hidden="true">JUNNIE’S JOURNAL ✦</p>
    <h1 id="home-title">欢迎来到Junnie的个人主页</h1>
    <p class="hero-desc">这里记录追星和科研日常</p>
  </div>
  <div class="apple-link-row">
    <a href={url('/gallery/')} class="apple-link">看看我的线下返图
      <Icon name="material-symbols:chevron-right-rounded" class="apple-chevron" aria-hidden="true"></Icon>
    </a>
    <MemoryStack memories={memories} />
    <a href={url('/research/')} class="apple-link">打开科研手记
      <Icon name="material-symbols:chevron-right-rounded" class="apple-chevron" aria-hidden="true"></Icon>
    </a>
  </div>
  <div class="hero-social">
    <p class="hero-social-label">在这些地方找到我</p>
    <ProfileLinks />
  </div>
</section>

<style>
  .home-hero {
    padding: 20px 2px 26px;
    color: var(--home-ink);
  }
  .hero-copy { margin-top: 22px; }
  .hero-kicker {
    margin-bottom: 8px;
    color: var(--primary);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .18em;
  }
  h1 {
    max-width: 19ch;
    font-size: clamp(28px, 7.2vw, 40px);
    font-weight: 700;
    line-height: 1.24;
    letter-spacing: -.025em;
    color: var(--home-ink);
    text-wrap: balance;
  }
  .hero-desc {
    margin-top: 9px;
    color: var(--home-muted);
    font-size: 15px;
    line-height: 1.65;
  }
  .apple-link-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.5rem;
    margin-top: 9px;
  }
  .apple-link-row :global(.apple-link) {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    min-height: 44px;
    font-family: var(--font-system);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -.01em;
    line-height: 1;
    white-space: nowrap;
    color: var(--primary);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: color .18s ease, opacity .18s ease;
  }
  .apple-link-row :global(.apple-chevron) {
    font-size: 1.125rem;
    transition: transform .18s cubic-bezier(.25, .1, .25, 1);
  }
  .apple-link-row :global(.apple-link:hover) { color: var(--title-active); }
  .apple-link-row :global(.apple-link:hover .apple-chevron) { transform: translateX(2px); }
  .apple-link-row :global(.apple-link:active) { opacity: .55; }
  .apple-link-row :global(.apple-link:focus-visible) {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
    border-radius: .375rem;
  }
  .hero-social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 6px;
  }
  .hero-social-label {
    color: var(--home-muted);
    font-size: 12px;
  }
  @media (min-width: 768px) {
    .home-hero { padding: 30px 4px 36px; }
    .hero-copy { margin-top: 26px; }
    .hero-desc { margin-top: 12px; font-size: 16px; }
    .apple-link-row { gap: 0 2rem; margin-top: 12px; }
    .hero-social { margin-top: 10px; }
  }
  @media (max-width: 359px) {
    .home-hero { padding-inline: 0; }
    .apple-link-row { gap: 0 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .apple-link-row :global(.apple-link),
    .apple-link-row :global(.apple-chevron) { transition: none; }
    .apple-link-row :global(.apple-link:hover .apple-chevron) { transform: none; }
  }
</style>
