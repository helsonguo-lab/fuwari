---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";
import ProfileLinks from "./ProfileLinks.astro";

interface Props {
	compact?: boolean;
	showLinks?: boolean;
}
const { compact = false, showLinks = true } = Astro.props;
const config = profileConfig;
---
<div class:list={[compact ? "profile-compact" : "card-base p-3", "profile-root"]}>
    <a aria-label="关于 Junnie" href={url('/about/')}
       class:list={["group block relative overflow-hidden active:scale-95",
       compact ? "profile-avatar" : "mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3 max-w-[12rem] lg:max-w-none rounded-xl"]}>
        <div class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center">
            <Icon name="fa6-regular:address-card"
                  class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl">
            </Icon>
        </div>
        <ImageWrapper src={config.avatar || ""} alt={`${config.name} 的头像`} class="mx-auto w-full h-full"></ImageWrapper>
    </a>
    <div class:list={[compact ? "profile-copy" : "px-2"]}>
        <div class:list={[compact ? "profile-name" : "font-bold text-xl text-center mb-1 dark:text-neutral-50 transition"]}>{config.name}</div>
        <div class:list={[compact ? "profile-divider" : "h-1 w-5 bg-[var(--primary)] mx-auto rounded-full mb-2 transition"]}></div>
        <div class:list={[compact ? "profile-bio" : "text-center text-60 mb-2.5 transition"]}>{config.bio}</div>
        {showLinks && <div class:list={[compact ? "profile-links" : "flex flex-wrap gap-2 justify-center mb-1"]}>
            <ProfileLinks />
        </div>}
    </div>
</div>

<style>
    .profile-compact {
        display: grid;
        grid-template-columns: 60px minmax(0, 1fr);
        align-items: center;
        gap: 14px;
        color: var(--home-ink);
    }
    .profile-avatar {
        width: 60px;
        height: 60px;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent);
        box-shadow: 0 4px 14px rgb(54 82 101 / 12%);
    }
    .profile-copy { min-width: 0; }
    .profile-name {
        font-size: 17px;
        font-weight: 700;
        line-height: 1.25;
        letter-spacing: -.01em;
    }
    .profile-divider { display: none; }
    .profile-bio {
        margin-top: 2px;
        color: var(--home-muted);
        font-size: 13px;
        line-height: 1.5;
    }
    .profile-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 9px;
    }
    @media (min-width: 768px) {
        .profile-compact {
            grid-template-columns: 76px minmax(0, 1fr);
            gap: 18px;
        }
        .profile-avatar { width: 76px; height: 76px; }
        .profile-name { font-size: 20px; }
        .profile-bio { font-size: 14px; }
    }
    @media (prefers-reduced-motion: reduce) {
        .profile-root :global(*) { transition: none; }
    }
</style>
