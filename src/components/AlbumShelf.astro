---
import { Icon } from "astro-icon/components";
import { albums } from "../data/albums";
import { socialProfiles } from "../data/social";
import { url } from "../utils/url-utils";
---

<album-shelf>
  <button type="button" aria-label="查看我喜欢的专辑" title="Spotify" aria-haspopup="dialog" aria-controls="album-covers"
    class="btn-regular rounded-lg h-11 w-11 active:scale-90" data-spotify-trigger>
    <Icon name="fa6-brands:spotify" class="text-[1.5rem]" />
  </button>

  <dialog id="album-covers" aria-labelledby="album-covers-title" class="card-base album-dialog" data-pagefind-ignore>
    <div class="album-heading">
      <h2 id="album-covers-title">我喜欢的专辑</h2>
      <form method="dialog">
        <button aria-label="关闭专辑封面" class="btn-plain rounded-full w-11 h-11" autofocus>
          <Icon name="material-symbols:close-rounded" class="text-2xl" />
        </button>
      </form>
    </div>
    <div class="album-grid">
      {albums.map(album => <img src={url(album.cover)} alt={`${album.artist} — ${album.title}`} width="480" height="480" loading="lazy" decoding="async" />)}
    </div>
    <a href={socialProfiles.spotify} target="_blank" rel="me noopener noreferrer" class="btn-regular album-profile rounded-lg gap-2">
      <Icon name="fa6-brands:spotify" class="text-xl" />
      <span>打开 Spotify 主页</span>
      <Icon name="material-symbols:open-in-new-rounded" class="text-base" />
    </a>
  </dialog>
</album-shelf>

<script>
  class AlbumShelf extends HTMLElement {
    private events?: AbortController;

    connectedCallback() {
      this.events?.abort();
      this.events = new AbortController();
      const { signal } = this.events;
      const trigger = this.querySelector<HTMLButtonElement>("[data-spotify-trigger]");
      const dialog = this.querySelector("dialog");
      if (!trigger || !dialog) return;

      // Swup may reconnect cached markup carrying an old open attribute.
      dialog.close();
      dialog.removeAttribute("open");

      trigger.addEventListener("click", () => dialog.showModal(), { signal });
      dialog.addEventListener("close", () => {
        if (!dialog.open && this.isConnected) trigger.focus({ preventScroll: true });
      }, { signal });
      dialog.addEventListener("click", event => {
        if (event.target !== dialog) return;
        const box = dialog.getBoundingClientRect();
        if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) {
          dialog.close();
        }
      }, { signal });
    }

    disconnectedCallback() {
      this.events?.abort();
      this.querySelector("dialog")?.close();
    }
  }
  if (!customElements.get("album-shelf")) customElements.define("album-shelf", AlbumShelf);
</script>

<style>
  album-shelf { display: contents; }
  album-shelf :is(button, a):focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
  .album-dialog {
    /* Match the fan-map dialog: fixed + viewport-based height keeps the close
       button visible and the panel centered on mobile, whatever the page scroll. */
    position: fixed;
    inset: 0;
    width: min(640px, calc(100vw - 32px));
    height: fit-content;
    max-height: calc(100vh - 32px);
    max-height: calc(100svh - 32px);
    margin: auto;
    padding: 18px 24px 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
    color: var(--btn-content);
  }
  .album-dialog::backdrop { background: rgb(22 38 51 / 32%); backdrop-filter: blur(7px); }
  .album-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .album-heading button { width: 44px; height: 44px; flex: none; }
  .album-heading h2 { font-size: 1.125rem; font-weight: 700; }
  .album-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .album-grid img { width: 100%; aspect-ratio: 1; height: auto; border-radius: 10px; object-fit: contain; box-shadow: 0 4px 16px #2033441a; }
  .album-profile { min-height: 44px; margin-top: 18px; font-size: 0.875rem; font-weight: 600; }
  @media (max-width: 480px) {
    .album-dialog {
      width: calc(100vw - 24px);
      max-height: calc(100vh - 24px);
      max-height: calc(100svh - 24px);
      padding: 12px 16px 16px;
    }
    .album-grid { gap: 10px; }
  }
</style>
