---
import { Icon } from "astro-icon/components";
import { albums } from "../data/albums";
import { url } from "../utils/url-utils";
---

<album-shelf>
  <button type="button" aria-label="查看专辑封面" title="Spotify" aria-haspopup="dialog" aria-controls="album-covers"
    class="btn-regular rounded-lg h-10 w-10 active:scale-90" data-album-open>
    <Icon name="fa6-brands:spotify" class="text-[1.5rem]" />
  </button>
  <dialog id="album-covers" aria-label="专辑封面" class="card-base album-dialog" data-pagefind-ignore>
    <form method="dialog" class="flex justify-end mb-4">
      <button aria-label="关闭专辑封面" class="btn-plain rounded-full w-10 h-10" autofocus>
        <Icon name="material-symbols:close-rounded" class="text-2xl" />
      </button>
    </form>
    <div class="album-grid">
      {albums.map(album => <img src={url(album.cover)} alt={`${album.artist} — ${album.title}`} width="480" height="480" loading="lazy" decoding="async" />)}
    </div>
  </dialog>
</album-shelf>

<script>
  class AlbumShelf extends HTMLElement {
    connectedCallback() {
      const dialog = this.querySelector("dialog");
      this.querySelector("[data-album-open]")?.addEventListener("click", () => dialog?.showModal());
      dialog?.addEventListener("click", event => {
        if (event.target !== dialog) return;
        const box = dialog.getBoundingClientRect();
        if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) {
          dialog.close();
        }
      });
    }
  }
  if (!customElements.get("album-shelf")) customElements.define("album-shelf", AlbumShelf);
</script>

<style>
  album-shelf { display: contents; }
  .album-dialog {
    width: min(680px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 18px 24px 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
    color: var(--btn-content);
  }
  .album-dialog::backdrop { background: rgb(22 38 51 / 32%); backdrop-filter: blur(7px); }
  .album-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .album-grid img { width: 100%; aspect-ratio: 1; height: auto; border-radius: 10px; object-fit: contain; box-shadow: 0 4px 16px #2033441a; }
  @media (max-width: 480px) {
    .album-dialog { padding: 12px 16px 20px; }
    .album-grid { gap: 10px; }
  }
</style>
