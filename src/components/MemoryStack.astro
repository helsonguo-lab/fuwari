---
import { Icon } from "astro-icon/components";
import type { MemoryContent } from "../utils/homepage-content";
import { url } from "../utils/url-utils";
interface Props { memories: MemoryContent[]; }
const { memories } = Astro.props;
---
{memories.length > 0 && <memory-stack>
  <button type="button" class="apple-link" data-memory-open aria-haspopup="dialog" aria-controls="memory-dialog">翻翻我的回忆 ✦</button>
  <dialog id="memory-dialog" class="memory-dialog" aria-labelledby="memory-title" aria-describedby="memory-help" data-pagefind-ignore>
    <header class="memory-heading">
      <h2 id="memory-title">翻翻我的回忆 <span aria-hidden="true">✦</span></h2>
      <button type="button" class="memory-close btn-plain rounded-full" data-memory-close aria-label="关闭回忆" autofocus>
        <Icon name="material-symbols:close-rounded" class="text-2xl" />
      </button>
    </header>
    <div class="memory-stage" data-memory-stage></div>
    <footer class="memory-footer">
      <p id="memory-help">{memories.length > 1 ? '左右轻滑，或翻下一张' : '把这一刻，好好收着'}</p>
      <div class="memory-actions">
        <span class="memory-count" data-memory-count role="status" aria-live="polite" aria-atomic="true"></span>
        {memories.length > 1 && <button type="button" class="btn-regular rounded-lg" data-memory-next>下一张 <span aria-hidden="true">↗</span></button>}
      </div>
    </footer>
  </dialog>
  {memories.map(memory => <template data-memory-template>
    <article class="memory-paper" data-memory-id={memory.id} aria-label={`${memory.date} · ${memory.location}`}>
      <div class="photo-window">
        <img data-src={url(memory.photo)} alt={memory.alt} width={memory.width} height={memory.height} decoding="async" draggable="false" />
        <p class="photo-fallback" hidden>这张照片暂时没加载出来</p>
      </div>
      <div class="paper-caption" tabindex="0" aria-label="回忆文字，可上下滚动">
        <div class="memory-emotion" set:html={memory.emotion}></div>
        <p class="memory-meta"><time datetime={memory.date}>{memory.date.replaceAll('-', '.')}</time><span aria-hidden="true"> · </span>{memory.location}</p>
      </div>
    </article>
  </template>)}
</memory-stack>}

<script>
  import "../scripts/memory-stack";
</script>

<style>
  @font-face {
    font-family: "Zhi Mang Xing";
    src: url("/fonts/zhimangxing/ZhiMangXing-Regular.ttf") format("truetype");
    font-display: swap;
    font-weight: 400;
    font-style: normal;
  }
  memory-stack { display: contents; }
  .memory-dialog {
    position: fixed; inset: 0; margin: auto;
    width: min(680px, calc(100vw - 24px)); height: fit-content;
    max-height: calc(100vh - 24px); max-height: calc(100svh - 24px);
    padding: 12px 16px 16px; overflow: hidden; border: 1px solid rgb(255 255 255 / 25%);
    border-radius: 22px; color: var(--btn-content);
    background: color-mix(in srgb, var(--card-bg) 94%, transparent);
    box-shadow: 0 24px 100px #16263335; overscroll-behavior: contain;
  }
  .memory-dialog::backdrop { background: rgb(22 38 51 / 30%); backdrop-filter: blur(6px); }
  .memory-heading { display: flex; justify-content: space-between; align-items: center; gap: 8px; min-height: 44px; }
  h2 { padding-left: 8px; font-size: .9375rem; font-weight: 600; }
  h2 span { color: var(--primary); margin-left: .25rem; }
  .memory-close { width: 44px; height: 44px; flex: 0 0 auto; display: grid; place-items: center; }
  .memory-stage { position: relative; height: min(550px, calc(100vh - 188px)); height: min(550px, calc(100svh - 188px)); isolation: isolate; }
  .memory-paper {
    position: absolute; inset: 14px 0 24px; margin-inline: auto;
    width: min(340px, calc(100% - 48px)); padding: 12px 12px 16px;
    display: flex; flex-direction: column; gap: 0; background: #fffefa; border: 1px solid #f2f0e9;
    color: #344859; box-shadow: 0 2px 4px #16263316, 0 12px 28px #16263330;
    transform-origin: 50% 65%; border-radius: 2px; user-select: none; touch-action: pan-y;
    will-change: transform;
    background-image: linear-gradient(120deg, #ffffff00 55%, #e9e5da22);
  }
  .photo-window { flex: 1 1 0; min-height: 0; position: relative; background: #f4f3ef; }
  .photo-window img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .photo-fallback { position: absolute; inset: 0; padding: 1rem; align-content: center; text-align: center; font-size: .8125rem; color: #607080; background: #f4f3ef; }
  .paper-caption { flex: 0 0 auto; max-height: 43%; padding: 12px 5px 0; overflow: auto; overscroll-behavior: contain; touch-action: pan-y; scrollbar-width: thin; user-select: text; }
  .memory-emotion { font-family: "Zhi Mang Xing", "Kaiti SC", KaiTi, "STKaiti", "PingFang SC", "Microsoft YaHei", cursive; font-weight: 400; font-size: 1.6rem; line-height: 1.5; text-align: left; overflow-wrap: anywhere; color: #344859; }
  .memory-emotion :global(p + p) { margin-top: .35em; }
  .memory-emotion :global(code) { font: inherit; }
  .memory-meta { margin-top: 10px; font-size: .625rem; line-height: 1.6; color: #667582; overflow-wrap: anywhere; }
  .memory-footer { padding: 4px 8px 0; }
  .memory-footer > p { font-size: .6875rem; opacity: .7; text-align: center; }
  .memory-actions { display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 8px; min-height: 44px; }
  .memory-count { font-size: .75rem; font-variant-numeric: tabular-nums; }
  [data-memory-next] { min-height: 44px; padding: 0 16px; display: inline-flex; gap: 8px; font-size: .8125rem; }
  [data-memory-next]:disabled { opacity: .55; cursor: default; }
  .memory-dialog :is(button, .paper-caption):focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
  @media (max-width: 480px) {
    .memory-dialog { padding: 8px 10px 12px; border-radius: 18px; }
    .memory-paper { padding: 10px 10px 13px; }
    .memory-emotion { font-size: 1.4rem; }
  }
  @media (max-height: 450px) and (min-width: 600px) {
    .memory-dialog { width: min(680px, calc(100vw - 24px)); }
    .memory-stage { height: calc(100svh - 160px); }
    .memory-paper { width: min(300px, calc(100% - 64px)); padding: 8px 8px 10px; }
    .paper-caption { max-height: 46%; padding: 6px 4px 0; }
    .memory-emotion { font-size: 1.1rem; line-height: 1.3; }
    .memory-meta { margin-top: 6px; }
    .memory-footer > p { display: none; }
  }
  @media (prefers-reduced-transparency: reduce) {
    .memory-dialog { background: var(--card-bg); }
    .memory-dialog::backdrop { background: rgb(22 38 51 / 65%); backdrop-filter: none; }
  }
</style>
