---

<fan-map>
  <section class="surface-home map-card mb-4" aria-labelledby="fan-map-title">
    <div class="map-head">
      <div>
        <p class="map-kicker">MY STARRY MAP ✦</p>
        <h2 id="fan-map-title">追星地图</h2>
        <p class="map-copy">与你们的记忆</p>
      </div>
      <div class="map-side">
        <p class="map-stats" aria-label={`${showCount} 场演出，${cityCount} 座城市`}>
          <span><strong>{showCount}</strong> 场演出</span>
          <span class="stats-divider" aria-hidden="true"></span>
          <span><strong>{cityCount}</strong> 座城市</span>
        </p>
        <p class="map-legend" aria-hidden="true">
          <span><i class="legend-dot ive"></i>IVE</span>
          <span><i class="legend-dot nmixx"></i>NMIXX</span>
        </p>
      </div>
    </div>

    <div class="map-frame">
      <svg class="map-svg" viewBox={`0 0 ${VIEW_WIDTH} ${VIEW_HEIGHT}`} role="img" aria-labelledby="fan-map-svg-title fan-map-svg-desc" preserveAspectRatio="xMidYMid meet">
        <title id="fan-map-svg-title">Junnie 的东亚追星地图</title>
        <desc id="fan-map-svg-desc">东亚地图，标出东京、仁川、澳门和香港的 {markers.length} 个已看场次，点击地图上的标记可以查看场次照片。</desc>
        <g class="graticule" aria-hidden="true">
          {longitudeLines.map(line => <line {...line} />)}
          {latitudeLines.map(line => <line {...line} />)}
        </g>
        <g class="landmass" aria-hidden="true"><Fragment set:html={landPaths} /></g>
        <g class="geo-labels" aria-hidden="true">
          <text x="205" y="405">中国</text>
          <text x="790" y="388">日本</text>
          <text x="558" y="352">韩国</text>
        </g>
        <g class="leaders" aria-hidden="true">
          {markers.filter(marker => marker.hasOffset).map(marker => (
            <line x1={marker.anchor.x} y1={marker.anchor.y} x2={marker.x} y2={marker.y} />
          ))}
          {anchors.map(anchor => <circle cx={anchor.x} cy={anchor.y} r="3.2" class="anchor-dot" />)}
        </g>
      </svg>

      {markers.map(marker => (
        <button
          type="button"
          class:list={["pin", `pin-${marker.group.toLowerCase()}`]}
          style={positionStyle(marker.x, marker.y)}
          aria-haspopup="dialog"
          aria-controls={`fan-map-dialog-${marker.id}`}
          aria-label={`${marker.group}，${marker.venue}，${formatDates(marker.dates)}${marker.photo ? "，查看现场照片" : "，照片敬请期待"}`}
          data-map-trigger
        >
          <svg viewBox="0 0 34 46" class="pin-shape" aria-hidden="true">
            <path class="pin-body" d="M17 0C7.6 0 0 7.6 0 17c0 12.9 17 29 17 29s17-16.1 17-29C34 7.6 26.4 0 17 0Z" />
            <circle cx="17" cy="16.5" r="6.3" fill="white" opacity=".94" />
            <circle cx="17" cy="16.5" r="2.2" class="pin-dot" />
          </svg>
          <span class="pin-label">
            <span class="pin-city">{marker.city}</span>
            <span class="pin-date">{formatDates(marker.dates)}</span>
          </span>
        </button>
      ))}
    </div>

    <div class="map-event-list" aria-label="场次快捷入口">
      {markers.map(marker => (
        <button type="button" class="map-event-chip" data-map-trigger aria-haspopup="dialog"
                aria-controls={`fan-map-dialog-${marker.id}`}
                aria-label={`打开 ${marker.group} ${marker.city} ${formatDates(marker.dates)} 场次详情`}>
          <i class:list={["legend-dot", marker.group.toLowerCase()]} aria-hidden="true"></i>
          <span class="chip-copy">
            <span class="chip-heading"><span class="chip-city">{marker.city}</span><span class="chip-group">{marker.group}</span></span>
            <span class="chip-date">{formatDates(marker.dates)}</span>
          </span>
        </button>
      ))}
    </div>

  </section>

  {markers.map(marker => (
    <dialog id={`fan-map-dialog-${marker.id}`} class="card-base map-dialog" aria-labelledby={`fan-map-dialog-title-${marker.id}`} data-pagefind-ignore>
      <div class="dialog-head">
        <div>
          <p class="dialog-kicker"><i class:list={["legend-dot", marker.group.toLowerCase()]} aria-hidden="true"></i>{marker.group} · {marker.city}</p>
          <h3 id={`fan-map-dialog-title-${marker.id}`} class="dialog-title">{marker.tour}</h3>
          <p class="dialog-meta">{formatDates(marker.dates)} · {marker.venue}</p>
        </div>
        <form method="dialog">
          <button aria-label="关闭场次详情" class="btn-plain rounded-full w-11 h-11 shrink-0" autofocus>
            <svg viewBox="0 0 24 24" class="w-6 h-6 mx-auto" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </button>
        </form>
      </div>

      {marker.photo ? (
        <figure class="dialog-photo">
          <img src={url(marker.photo.src)} alt={`${marker.group} ${marker.venue} ${formatDates(marker.dates)} 现场照片`} width={marker.photo.width} height={marker.photo.height} loading="lazy" decoding="async" />
          <figcaption>{[marker.group, formatDates(marker.dates), marker.venue].join(" · ")}</figcaption>
        </figure>
      ) : (
        <div class="dialog-empty">
          <span class="empty-star" aria-hidden="true">✧</span>
          <p class="empty-title">敬请期待</p>
          <p class="empty-copy">这一场的照片还在路上，先在地图上留个位置。</p>
        </div>
      )}

      <div class="dialog-foot">
        <span>{marker.shortName}</span>
        {marker.photo && <a href={url("/gallery/")} class="btn-plain rounded-lg px-4 py-2 text-xs font-bold">去线下返图看更多 ↗</a>}
      </div>
    </dialog>
  ))}
</fan-map>

<script>
  class FanMap extends HTMLElement {
    private events?: AbortController;

    connectedCallback() {
      this.events?.abort();
      this.events = new AbortController();
      const { signal } = this.events;

      this.querySelectorAll<HTMLDialogElement>("dialog").forEach(dialog => {
        dialog.close();
        dialog.removeAttribute("open");
        delete dialog.dataset.lastTriggerIndex;
        const triggers = [...this.querySelectorAll<HTMLButtonElement>(`[aria-controls="${dialog.id}"]`)];

        triggers.forEach((trigger, index) => trigger.addEventListener("click", () => {
          dialog.dataset.lastTriggerIndex = String(index);
          dialog.showModal();
        }, { signal }));
        dialog.addEventListener("close", () => {
          const index = Number(dialog.dataset.lastTriggerIndex ?? "-1");
          if (!dialog.open && this.isConnected) triggers[index]?.focus({ preventScroll: true });
        }, { signal });
        dialog.addEventListener("click", event => {
          if (event.target !== dialog) return;
          const box = dialog.getBoundingClientRect();
          if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) {
            dialog.close();
          }
        }, { signal });
      });
    }

    disconnectedCallback() {
      this.events?.abort();
      this.querySelectorAll("dialog").forEach(dialog => dialog.close());
    }
  }
  if (!customElements.get("fan-map")) customElements.define("fan-map", FanMap);
</script>

<style>
  fan-map { display: block; }
  .map-card { padding: 18px 20px 17px; color: var(--home-ink); }
  .map-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .map-kicker { margin-bottom: 5px; color: var(--primary); font-size: 10px; font-weight: 700; letter-spacing: .18em; }
  .map-head h2 { font-size: 22px; font-weight: 700; line-height: 1.2; letter-spacing: -.015em; }
  .map-copy { margin-top: 5px; color: var(--home-muted); font-size: 14px; }
  .map-side { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
  .map-stats { display: inline-flex; align-items: center; gap: 8px; padding: 5px 12px; border-radius: 999px; border: 1px solid var(--home-line); background: color-mix(in srgb, var(--card-bg) 60%, transparent); color: var(--home-muted); font-size: 11px; }
  .map-stats strong { font-size: 15px; line-height: 1; color: var(--primary); }
  .stats-divider { width: 1px; height: 14px; background: color-mix(in srgb, var(--btn-content) 20%, transparent); }
  .map-legend { display: flex; gap: 12px; font-size: 10px; color: var(--home-muted); letter-spacing: .04em; }
  .map-legend > span { display: inline-flex; align-items: center; gap: 5px; }
  .legend-dot { display: inline-block; width: 8px; height: 8px; border-radius: 999px; flex: none; }
  .legend-dot.ive { background: #dc6f9f; }
  .legend-dot.nmixx { background: #5a86b4; }

  .map-frame {
    position: relative;
    width: 100%;
    max-width: 900px;
    aspect-ratio: 1000 / 700;
    margin: 16px auto 0;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--primary) 12%, transparent);
    background: linear-gradient(155deg, #e9f6fd 0%, #d8ecf7 52%, #e9f3fb 100%);
  }
  .map-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .graticule line { stroke: #a9cadd; stroke-width: 1; stroke-dasharray: 2 5; opacity: .5; vector-effect: non-scaling-stroke; }
  :global(.land) { fill: #fbfdff; stroke: #bed9e8; stroke-width: 1.1; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .geo-labels text { fill: #7597ab; font-size: 13px; letter-spacing: .28em; opacity: .8; }
  .leaders line { stroke: #8ba9bd; stroke-width: 1.1; stroke-dasharray: 3 4; opacity: .72; vector-effect: non-scaling-stroke; }
  .anchor-dot { fill: #7f9db2; opacity: .85; }

  .pin {
    position: absolute;
    width: 44px;
    height: 54px;
    padding: 0;
    border: 0;
    background: transparent;
    transform: translate(-50%, -100%);
    cursor: pointer;
    z-index: 2;
    transition: transform .18s ease, filter .18s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .pin:hover { transform: translate(-50%, -100%) translateY(-3px); }
  .pin:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; border-radius: 10px; }
  .pin-shape { position: absolute; bottom: 0; left: 5px; display: block; width: 34px; height: 46px; filter: drop-shadow(0 4px 7px rgb(42 68 89 / 22%)); }
  .pin-ive { --pin-color: #dc6f9f; --pin-dot: #b44f7c; }
  .pin-nmixx { --pin-color: #5a86b4; --pin-dot: #3f678f; }
  .pin-body { fill: var(--pin-color); }
  .pin-dot { fill: var(--pin-dot); }
  .pin-label {
    position: absolute;
    top: calc(100% + 1px);
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    padding: 3px 8px;
    border: 1px solid var(--home-line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--card-bg) 88%, transparent);
    box-shadow: 0 4px 12px rgb(64 95 115 / 10%);
    color: var(--home-ink);
    white-space: nowrap;
    line-height: 1.2;
    pointer-events: none;
  }
  .pin-city { font-size: 11px; font-weight: 700; letter-spacing: .06em; }
  .pin-date { font-size: 9px; opacity: .66; }

  .map-event-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 12px; }
  .map-event-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    min-height: 60px;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid var(--home-line);
    background: color-mix(in srgb, var(--btn-regular-bg) 42%, var(--card-bg));
    color: var(--btn-content);
    font-size: 12px;
    text-align: left;
    transition: background-color .16s ease;
  }
  .map-event-chip:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .map-event-chip:hover { background: var(--btn-regular-bg-hover); }
  .map-event-chip:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
  .chip-copy { display: grid; min-width: 0; gap: 3px; overflow-wrap: anywhere; }
  .chip-heading { display: flex; align-items: baseline; flex-wrap: wrap; gap: 3px 7px; line-height: 1.4; }
  .chip-city { font-size: 13px; font-weight: 600; }
  .chip-group { color: var(--home-muted); font-size: 10px; }
  .chip-date { color: var(--home-muted); font-size: 11px; line-height: 1.45; font-variant-numeric: tabular-nums; }

  .map-dialog {
    /* Explicit fixed positioning keeps the dialog centered in the visual viewport
       on mobile, even when the page behind is scrolled far down. */
    position: fixed;
    inset: 0;
    width: min(560px, calc(100vw - 32px));
