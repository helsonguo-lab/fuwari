---
import { fanMapEvents } from "../data/fan-map";
import { photos } from "../data/photos";
import { url } from "../utils/url-utils";

const VIEW_WIDTH = 1000;
const VIEW_HEIGHT = 700;
const LON_MIN = 104;
const LON_MAX = 146;
const LAT_MIN = 16;
const LAT_MAX = 48;

const mercator = (lat: number) => {
	const phi = (lat * Math.PI) / 180;
	return (Math.log(Math.tan(Math.PI / 4 + phi / 2)) * 180) / Math.PI;
};
const mercatorMin = mercator(LAT_MIN);
const mercatorMax = mercator(LAT_MAX);
const project = ([lon, lat]: [number, number]) => ({
	x: ((lon - LON_MIN) / (LON_MAX - LON_MIN)) * VIEW_WIDTH,
	y: ((mercatorMax - mercator(lat)) / (mercatorMax - mercatorMin)) * VIEW_HEIGHT,
});

const events = fanMapEvents.filter(event => event.showOnHome !== false);
const markers = events.map(event => {
	const anchor = project(event.coordinates);
	const [dx, dy] = event.pinOffset ?? [0, 0];
	return {
		...event,
		anchor,
		x: anchor.x + dx,
		y: anchor.y + dy,
		hasOffset: dx !== 0 || dy !== 0,
		photo: event.photoEventId
			? photos.find(photo => photo.eventId === event.photoEventId)
			: undefined,
	};
});
const showCount = events.reduce((total, event) => total + event.dates.length, 0);
const cityCount = new Set(events.map(event => event.city)).size;
const formatDate = (iso: string) => iso.replaceAll("-", ".");
const formatDates = (dates: string[]) =>
	dates.length > 1
		? `${formatDate(dates[0])} – ${formatDate(dates[dates.length - 1])}`
		: formatDate(dates[0]);
const positionStyle = (x: number, y: number) =>
	`left:${(x / VIEW_WIDTH) * 100}%;top:${(y / VIEW_HEIGHT) * 100}%`;

const longitudeLines = [110, 115, 120, 125, 130, 135, 140, 145].map(lon => {
	const top = project([lon, LAT_MAX]);
	const bottom = project([lon, LAT_MIN]);
	return { x1: top.x, y1: top.y, x2: bottom.x, y2: bottom.y };
});
const latitudeLines = [20, 25, 30, 35, 40, 45].map(lat => {
	const left = project([LON_MIN, lat]);
	const right = project([LON_MAX, lat]);
	return { x1: left.x, y1: left.y, x2: right.x, y2: right.y };
});

// 锚点去重：同一座场馆的多场演出共用一条虚线起点。
const anchors = [
	...new Map(
		markers
			.filter(marker => marker.hasOffset)
			.map(marker => [`${marker.anchor.x},${marker.anchor.y}`, marker.anchor]),
	).values(),
];

const landPaths = `<path class="land" data-country="Russia" d="M847.4 0L822.7 26.8L814.8 45.1L735 119.4L703.3 134L688.2 134.3L673.3 122.3L641.3 140.4L637.6 148.5L634.3 144.2L634.1 131.7L646.3 131.1L649.7 101.6L643.5 79.8L663.9 70.7L692.8 75.3L708.8 50.1L717 21.2L726.2 11.4L732 0L689.8 0L678.7 5.7L642.6 5.7L640.4 0ZM919.4 0L918.1 3.7L941.3 31.1L940.6 49.5L922.6 33.7L907 54L902.5 32L905.2 5.9L904.7 0Z" />
