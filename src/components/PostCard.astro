---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
	compact?: boolean;
}
const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	category,
	image,
	description,
	style,
	compact = false,
} = Astro.props;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";

const { remarkPluginFrontmatter } = await entry.render();
---
<article class:list={["surface-home home-post", className]} style={style}>
    <div class="post-copy">
        <a href={url} class="post-title">
            {title}
        </a>

        <PostMetadata published={published} updated={updated} tags={tags} category={category} hideTagsForMobile={true} hideUpdateDate={true} class="post-meta" compact></PostMetadata>

        <p class="post-description">
            {description || remarkPluginFrontmatter.excerpt}
        </p>

        <div class="post-stats">
            <span>{remarkPluginFrontmatter.words} {i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}</span>
            <span aria-hidden="true">·</span>
            <span>{remarkPluginFrontmatter.minutes} {i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}</span>
        </div>
    </div>

    {hasCover && <a href={url} aria-label={title} class="post-cover" tabindex="-1">
        <ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))} alt={`${title} 封面`} class="w-full h-full"></ImageWrapper>
    </a>}

    <a href={url} aria-label={`阅读 ${title}`} class="post-arrow">
        <Icon name="material-symbols:chevron-right-rounded"></Icon>
    </a>
</article>
{!compact && <div class="transition border-t-[1px] border-dashed mx-6 border-black/10 dark:border-white/[0.15] last:border-t-0 md:hidden"></div>}

<style>
    .home-post {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 6px 14px;
        padding: 18px 18px 17px;
        color: var(--home-ink);
    }
    .post-copy { min-width: 0; max-width: 780px; }
    .post-title {
        display: flex;
        align-items: center;
        min-height: 44px;
        color: var(--home-ink);
        font-size: 20px;
        font-weight: 700;
        line-height: 1.35;
        letter-spacing: -.015em;
        text-decoration: none;
        overflow-wrap: anywhere;
    }
    .post-title:hover { color: var(--primary); }
    .post-meta { margin-top: 7px; }
    .post-description {
        margin-top: 8px;
        color: var(--home-muted);
        font-size: 15px;
        line-height: 1.65;
        overflow-wrap: anywhere;
    }
    .post-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 9px;
        color: var(--home-muted);
        font-size: 12px;
    }
    .post-cover {
        width: 82px;
        height: 82px;
        grid-column: 2;
        grid-row: 1;
        border-radius: 12px;
        overflow: hidden;
    }
    .post-arrow {
        grid-column: 2;
        grid-row: 1;
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 999px;
        color: var(--primary);
        font-size: 1.5rem;
        transition: background-color .16s ease;
    }
    .post-arrow:hover { background: var(--btn-plain-bg-hover); }
    .post-cover + .post-arrow { display: none; }
    .home-post :global(a:focus-visible) { outline: 2px solid var(--primary); outline-offset: 2px; border-radius: 6px; }
    @media (min-width: 768px) {
        .home-post { padding: 22px 24px 21px; gap: 8px 20px; }
        .post-title { font-size: 24px; }
        .post-description { font-size: 16px; }
        .post-cover { width: 108px; height: 108px; }
    }
    @media (prefers-reduced-motion: reduce) {
        .post-arrow { transition: none; }
    }
</style>
